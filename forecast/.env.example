# Copie ce fichier en ".env" et remplis les valeurs (ne jamais mettre .env sur Git)

# Base de données : rôle sentinel_ia, mot de passe = DB_IA_PASSWORD de backend/.env
DATABASE_URL=postgresql+psycopg://sentinel_ia:a-remplir@127.0.0.1:5432/sentinel

# API du backend. API_KEY = la clé du service "anomaly" déclarée dans
# SERVICE_API_KEYS=vision=...,anomaly=... (backend/.env)
API_URL=http://localhost:3000/api/v1/alerts
API_KEY=a-remplir
TLS_VERIFY=true

# Secondes entre deux lectures de telemetry
INTERVALLE_S=2

# Capteur Hall (valeur brute de l'ADC) : repos ~VCC/2 (512 en 10 bits, 2048 en
# 12 bits) ; au-delà de MAG_SEUIL d'écart, on considère qu'un aimant est présent.
MAG_REPOS=512
MAG_SEUIL=100

LOG_LEVEL=INFO
