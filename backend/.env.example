# Sentinel-X backend : copier en .env (jamais commité) et remplir.

NODE_ENV=production
PORT=3000

# Compte applicatif (droits limités, cf. db/migrations/0003_roles.sql)
DATABASE_URL=postgres://sentinel_app:CHANGE_ME@db:5432/sentinel

# Compte propriétaire, seulement pour npm run db:migrate / db:roles / db:seed
DB_ADMIN_URL=postgres://sentinel:CHANGE_ME@db:5432/sentinel
# Mots de passe des rôles posés par npm run db:roles (16 caractères min.)
DB_APP_PASSWORD=
DB_IA_PASSWORD=
DB_VISION_PASSWORD=
# Premier compte admin créé par npm run db:seed (12 caractères min.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
JWT_TTL_S=43200
# Origine du dashboard (CORS), plusieurs séparées par des virgules
CORS_ORIGIN=https://sentinel.local
# false seulement en développement sans HTTPS
COOKIE_SECURE=true
TRUST_PROXY=loopback, uniquelocal

# Broker : TLS uniquement en production (port 8883)
MQTT_ENABLED=true
MQTT_URL=mqtts://mosquitto:8883
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_CA_FILE=/certs/ca.crt
MQTT_REJECT_UNAUTHORIZED=true

# Clés X-Api-Key des services internes (24 caractères min.) : openssl rand -hex 24
SERVICE_API_KEYS=vision=CHANGE_ME,anomaly=CHANGE_ME

# URL interne de vision.py (enregistrement des visages par webcam)
VISION_URL=http://vision:8000
