# Sentinel-X backend : copier en .env (jamais commité) et remplir.
# Lu par les commandes npm lancées hors Docker (start:dev, db:*, sim:esp).
# Avec le docker-compose.yml, ce fichier ne sert pas : tout vient du .env racine.
# Les adresses ci-dessous sont celles du développement local (docker-compose.dev.yml).

NODE_ENV=development
PORT=3000

# Compte applicatif (droits limités, cf. db/migrations/0003_roles.sql).
# Mot de passe = DB_APP_PASSWORD ci-dessous.
DATABASE_URL=postgres://sentinel_app:CHANGE_ME@localhost:5432/sentinel

# Compte propriétaire, seulement pour npm run db:migrate / db:roles / db:seed
# (sentinel / sentinel : identifiants de docker-compose.dev.yml)
DB_ADMIN_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
# Mots de passe des rôles posés par npm run db:roles (16 caractères min., ni @ ni : ni /) :
# openssl rand -hex 16. Un rôle laissé vide ne peut pas se connecter.
DB_APP_PASSWORD=
# Service de prévision (forecast/.env) et vision.py (vision/.env)
DB_IA_PASSWORD=
DB_VISION_PASSWORD=
# Premier compte admin créé par npm run db:seed (12 caractères min.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 32 caractères min. : openssl rand -base64 48
JWT_SECRET=
JWT_TTL_S=43200
# Origine du dashboard (CORS), plusieurs séparées par des virgules
CORS_ORIGIN=http://localhost:5173
# false seulement en développement sans HTTPS
COOKIE_SECURE=false
TRUST_PROXY=loopback, uniquelocal

# Broker de dev, en clair. En production : TLS uniquement (mqtts://mosquitto:8883),
# avec MQTT_USERNAME, MQTT_PASSWORD et MQTT_CA_FILE.
MQTT_ENABLED=true
MQTT_URL=mqtt://localhost:1883

# Clés X-Api-Key des services internes (24 caractères min.) : openssl rand -hex 24
# À remplir : l'API refuse de démarrer avec une clé trop courte.
SERVICE_API_KEYS=vision=CHANGE_ME,anomaly=CHANGE_ME

# URL de vision.py (enregistrement des visages par webcam), port VISION_PORT de vision/.env.
# La clé envoyée à vision.py est celle du service « vision » de SERVICE_API_KEYS.
VISION_URL=http://localhost:5001
