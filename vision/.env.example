# Copie ce fichier en ".env" et remplis les valeurs (ne jamais mettre .env sur Git)

# Numéro de la webcam USB (0, 1, 2... selon le PC)
CAMERA_INDEX=0

# API des alertes
API_URL=http://localhost:3000/api/v1/alerts
TLS_VERIFY=true
DEVICE_ID=SX-001

# Base de données (compte vision_service)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel
DB_USER=vision_service
DB_PASSWORD=a-remplir

# Compte administrateur : seulement pour add_person.py et mock_api.py
# (sur ton Mac, laisse vide : ton compte Mac est utilisé)
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=
