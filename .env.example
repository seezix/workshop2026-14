# Sentinel-X : modèle du fichier .env lu par docker-compose.yml.
# Copier en .env (jamais commité) et remplir les secrets : ils sont obligatoires,
# sans eux « docker compose up » s'arrête en nommant la variable manquante.
# Chaque installation doit avoir ses propres valeurs.

# --- Secrets obligatoires (ni @ ni : ni / : ils finissent dans des URL) ---
# Compte admin du dashboard, créé au premier lancement (12 caractères min.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Compte propriétaire de la base. Lu à la création du volume seulement : pour le
# changer ensuite, ALTER ROLE sentinel ... ou repartir d'une base vide (down -v).
POSTGRES_PASSWORD=
# Rôles Postgres (16 caractères min.), reposés à chaque « up » : openssl rand -hex 16
DB_APP_PASSWORD=
DB_IA_PASSWORD=
DB_VISION_PASSWORD=

# Signature des sessions (32 caractères min.) : openssl rand -hex 32
JWT_SECRET=

# Clés X-Api-Key des services (24 caractères min.) : openssl rand -hex 24
VISION_API_KEY=
ANOMALY_API_KEY=

# --- Réglages facultatifs ---
# Service lancé en plus du socle : sim (faux boîtier SX-001)
# COMPOSE_PROFILES=sim

# Ports publiés sur le serveur
# SX_HTTP_PORT=6080          # dashboard + API (http://<IP>:6080). Pas 6000 : refusé par les navigateurs
# SX_MQTT_PORT=6083          # broker MQTTS (TLS), à reporter dans le firmware de l'ESP (8883 = port MQTTS habituel)
# SX_DB_PORT=6032            # base, ouverte au serveur seulement (127.0.0.1) pour vision.py
# SX_MQTT_BIND=0.0.0.0       # 127.0.0.1 = broker fermé au réseau local

# --- Vision (vision.py, lancé hors Docker sur le serveur, voir README) ---
# Adresse de vision.py vue depuis les conteneurs
# VISION_URL=http://host.docker.internal:5001
# VISION_UPSTREAM=http://host.docker.internal:5001

# --- Prévision ---
# Capteur Hall : valeur de repos de l'ADC et écart qui signale un aimant
# MAG_REPOS=512
# MAG_SEUIL=100
# LOG_LEVEL=INFO

# --- Faux boîtier (profil « sim ») ---
# Intervalle des mesures, en secondes. Fixe : la config du dashboard (page Boîtier) ne le change pas
# SIM_INTERVAL_S=5
# Délai moyen entre deux anomalies d'environnement aléatoires, en secondes (0 = aucune)
# SIM_ANOMALY_EVERY_S=300
# Serveur du broker vu par le faux boîtier (par défaut : ce serveur, port SX_MQTT_PORT).
# Doit figurer dans le certificat du broker (voir infra/mosquitto/certs/README.md)
# SIM_MQTT_HOST=localhost
